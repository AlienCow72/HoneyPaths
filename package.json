{
  "name": "honeypaths",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "new-post": "node scripts/new-post.mjs",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "build:pages": "PUBLIC_PAGES_BUILD=true astro build",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/fraunces": "^5.2.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@types/node": "^24.19.1",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "satteri": "^0.10.5",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
