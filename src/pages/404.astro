---
import { withBase } from "../lib/paths.mjs";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
export const prerender = true;
---

<Layout title="A little lost?"
  ><section class="closing-section wrap">
    <Icon name="bee" size={50} /><span class="content-note"
      >404 · A little detour</span
    ><h1>Let’s find your<br />honey path.</h1><p>
      That page has wandered away. There’s still plenty to explore.
    </p><a class="button" href={withBase("/shop")}
      >Back to the good stuff <Icon name="arrow" /></a
    >
  </section></Layout
>
