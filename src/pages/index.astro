---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import products from "../data/products.json";
import { getCollection } from "astro:content";
export const prerender = true;
const featured = [products[27], products[10], products[43], products[54]];
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout>
  <section class="hero wrap">
    <div class="hero-copy">
      <span class="eyebrow"
        ><span class="tiny-star">✳</span> Handmade, with a little happy</span
      ><h1>Little things.<br /><em>Big personality.</em></h1><p>
        Earrings, stickers, and art for your wonderfully<br
          class="desktop-break"
        /> one-of-a-kind self. Made by hand. Full of heart.
      </p><div class="hero-actions">
        <a class="button" href="/shop"
          >Find your happy <Icon name="arrow" size={19} /></a
        ><a class="text-link" href="/about"
          >Meet the makers <Icon name="arrow" size={17} /></a
        >
      </div><div class="hero-footnote">
        <Icon name="heart" size={15} /> Small-batch creations, from our Colorado hive.
      </div>
    </div>
    <div
      class="hero-art"
      aria-label="A selection of Honey Path Designs handmade creations"
    >
      <svg
        class="flight-path"
        viewBox="0 0 540 500"
        fill="none"
        aria-hidden="true"
        ><path
          d="M27 368C-13 274 128 268 84 368s-74-19 32-69 236 149 282 46-53-113-45-45 94 55 130-54"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-dasharray="3 6"></path></svg
      >
      <div class="art-orbit"></div><span class="hero-spark spark-one">✳</span
      ><span class="hero-spark spark-two">✧</span>
      <div class="collage-card collage-pink">
        <span class="collage-number">01 / A LITTLE WHIMSY</span><img
          src={products[27].image}
          alt="Purple unicorn balloon animal earrings"
          width="270"
          height="330"
          fetchpriority="high"
        /><span class="collage-caption">wear your happy.</span>
      </div>
      <div class="collage-card collage-sage">
        <img
          src={products[43].image}
          alt="Playful ghost sticker"
          width="210"
          height="230"
        /><span class="collage-caption">stick to being you.</span>
      </div>
      <div class="collage-card collage-lilac">
        <img
          src={products[10].image}
          alt="Checkered heart guitar pick earrings"
          width="210"
          height="280"
        /><span class="collage-caption">a little love.</span>
      </div>
      <div class="hive-stamp">
        <span>MADE WITH</span><Icon name="bee" size={35} /><span
          >HEART & HANDS</span
        >
      </div>
      <span class="art-note">a little different.<br />just like you.</span>
    </div>
  </section>
  <div class="values-strip">
    <div class="wrap">
      <span><Icon name="flower" /> Handmade with care</span><span
        ><Icon name="heart" /> Small batches, big heart</span
      ><span><Icon name="bee" /> Anything but ordinary</span><span
        ><Icon name="flower" /> A little joy, every day</span
      >
    </div>
  </div>
  <section class="section wrap shop-preview">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Fresh from the hive</span><h2>
          Your next little <em>favorite.</em>
        </h2>
      </div><a class="text-link" href="/shop"
        >Explore the whole shop <Icon name="arrow" /></a
      >
    </div><div class="product-grid">
      {
        featured.map((product, index) => (
          <ProductCard product={product} index={index} />
        ))
      }
    </div>
  </section>
  <section class="story-section wrap">
    <div class="story-photo">
      <img
        src="/images/8851b74455106131dcf67508d5a8f556.jpg"
        alt="Joe and Saris smiling at each other"
        width="639"
        height="799"
        loading="lazy"
      /><span class="photo-label">the people behind the little things ♡</span
      ><span class="photo-flower"><Icon name="flower" size={76} /></span>
    </div><div class="story-copy">
      <span class="eyebrow">Two makers. One happy hive.</span><h2>
        Hi, we’re<br /><em>Joe & Saris.</em>
      </h2><p>
        Midwestern roots, Colorado hearts, and a shared love of making things
        that feel a little different.
      </p><p>
        Saris brings our stickers and art to life. Joe turns unexpected finds
        into earrings and key chains. Together, we’re Honey Path Designs.
      </p><a class="button button-outline" href="/about"
        >A little more about us <Icon name="arrow" /></a
      >
    </div>
  </section>
  <InstagramFeed />
  <section class="section buzz-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Notes from our little corner</span><h2>
            What’s the <em>buzz?</em>
          </h2>
        </div><a class="text-link" href="/blog"
          >All our stories <Icon name="arrow" /></a
        >
      </div><div class="post-preview-grid">
        {
          posts.map((post) => (
            <a class="post-preview" href={`/blog/${post.id}`}>
              <>
                <div class:list={["post-thumbnail", post.data.tone]}>
                  <img
                    src={post.data.image}
                    alt={post.data.imageAlt}
                    width="300"
                    height="300"
                    loading="lazy"
                  />
                </div>
                <div>
                  <>
                    <span class="eyebrow">{post.data.category}</span>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <span class="text-link">
                      Read the story <Icon name="arrow" size={16} />
                    </span>
                  </>
                </div>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="closing-section wrap">
    <Icon name="bee" size={40} /><h2>
      There’s a little happy<br /><em>with your name on it.</em>
    </h2><a class="button" href="/shop"
      >Follow your honey path <Icon name="arrow" /></a
    >
  </section>
</Layout>
