---
import { withBase } from "../lib/paths.mjs";
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import FeaturedPicker from "../components/FeaturedPicker.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import products from "../data/products.json";
import { getCollection } from "astro:content";
export const prerender = true;
const collage = [
  { product: products[27], caption: "wear your happy." },
  { product: products[43], caption: "stick to being you." },
  { product: products[10], caption: "a little love." },
  { product: products[46], caption: null },
];
const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<Layout>
  <section class="hero">
    <div class="hero-copy">
      <h1>Little things.<br />Big personality.</h1>
      <p>
        Earrings, stickers, and art for your wonderfully one-of-a-kind self.
        Made by hand. Full of heart.
      </p>
      <div class="hero-actions">
        <a class="button" href={withBase("/shop")}
          >Find your happy <Icon name="arrow" size={22} /></a
        >
      </div>
      <p class="hero-footnote">
        <Icon name="bee" size={24} /> Small-batch creations, from our Colorado hive.
      </p>
    </div>
    <div
      class="hero-art"
      aria-label="Handmade earrings, stickers, and art by Honey Path Designs"
    >
      {
        collage.map(({ product, caption }, index) => (
          <a
            class={`collage-piece collage-${index}`}
            href={withBase(`/shop/${product.id}`)}
            aria-label={`View ${product.name}`}
          >
            <img
              class:list={{
                "padded-art": product.id === "nsync-inspired-bi-bi-bi-sticker",
              }}
              src={withBase(product.image)}
              alt={product.name}
              width="420"
              height="500"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
            {caption && <span class="collage-caption">{caption}</span>}
          </a>
        ))
      }
    </div>
  </section>
  <div class="values-strip">
    <div class="wrap">
      <span>Handmade with care</span><Icon name="bee" size={28} /><span
        >Small batches, big heart</span
      ><Icon name="heart" size={24} /><span>Anything but ordinary</span>
    </div>
  </div>
  <section class="section wrap shop-preview">
    <div class="section-heading">
      <h2>Your next little favorite.</h2><a
        class="text-link"
        href={withBase("/shop")}>Explore the whole shop <Icon name="arrow" /></a
      >
    </div>
    <FeaturedPicker />
  </section>
  <section class="story-section wrap home-story">
    <div class="story-photo">
      <img
        src={withBase("/images/8851b74455106131dcf67508d5a8f556.jpg")}
        alt="Joe and Saris smiling at each other"
        width="639"
        height="799"
        loading="lazy"
      />
    </div>
    <div class="story-copy">
      <h2>Hi, we’re<br />Joe & Saris.</h2><p>
        Midwestern roots, Colorado hearts, and a shared love of making things
        that feel a little different.
      </p><p>
        Saris brings our stickers and art to life. Joe turns unexpected finds
        into earrings and key chains. Together, we’re Honey Path Designs.
      </p><a class="button button-outline" href={withBase("/about")}
        >A little more about us <Icon name="arrow" /></a
      >
    </div>
  </section>
  <InstagramFeed />
  <section class="section buzz-section">
    <div class="wrap">
      <div class="section-heading">
        <h2>What’s the buzz?</h2><a class="text-link" href={withBase("/blog")}
          >All our stories <Icon name="arrow" /></a
        >
      </div>
      <div class="post-preview-grid">
        {
          posts.map((post) => (
            <a class="post-preview" href={withBase(`/blog/${post.id}`)}>
              <div class:list={["post-thumbnail", post.data.tone]}>
                <img
                  src={withBase(post.data.image)}
                  alt={post.data.imageAlt}
                  width="300"
                  height="300"
                  loading="lazy"
                />
              </div>
              <div>
                <>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="post-category">{post.data.category}</span>
                  <span class="text-link">
                    Read the story <Icon name="arrow" size={18} />
                  </span>
                </>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="closing-section wrap home-closing">
    <div>
      <p class="closing-message">
        There’s a little happy<br />with your name on it.
      </p><a class="button" href={withBase("/shop")}
        >Follow your honey path <Icon name="arrow" /></a
      >
    </div>
    <img
      src={withBase(products[43].image)}
      alt="Honey Path’s cheeky ghost illustration sticker"
      width="500"
      height="500"
      loading="lazy"
    />
  </section>
</Layout>
